{
  "name": "api-registry",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "registry": "tsx src/api-registry/cli.ts",
    "demo": "tsx src/api-registry/cli.ts demo",
    "generate:demo": "tsx scripts/generate-demo.ts",
    "generate:examples": "tsx scripts/generate-examples.ts",
    "release:check": "npm test && npm run typecheck && npm run registry -- audit && npm run demo"
  },
  "devDependencies": {
    "@types/node": "^25.7.0",
    "tsx": "^4.21.0",
    "typescript": "^6.0.3",
    "vitest": "^4.1.6"
  }
}
